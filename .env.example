# Copy to .env.local (git-ignored) to set a machine-level default for the
# external API used when the "Use external API" dev toggle in Settings is
# switched on. You can also just set the Base URL directly in
# Settings > Developer Setting — that takes priority over this file and
# needs no rebuild. Has no effect in production builds — see src/api/api.js.

VITE_API_BASE_URL=http://localhost:4000/api
VITE_API_KEY=
